# DentalCore Production Backup Environment Configuration
# Target: /etc/dentalcore/backup.env
# Permissions: chmod 600 /etc/dentalcore/backup.env
# Ownership: chown dentalbackup:dentalbackup /etc/dentalcore/backup.env

BACKUP_DB_USER="dental_backup"
BACKUP_DB_PASSWORD="<STRONG_BACKUP_PASSWORD>"
BACKUP_DB_HOST="127.0.0.1"
BACKUP_DB_NAME="dentalcore"
BACKUP_DIR="/var/backups/dentalcore"
LOG_DIR="/var/log/dentalcore"

# Mandatory Cloud Storage Remote (configured via rclone config)
RCLONE_REMOTE="s3-backup:dentalcore-clinic-backups/daily"

# Webhook Alert Destination (Slack / Discord / PagerDuty / Monitoring Endpoint)
ALERT_WEBHOOK_URL="https://alerts.yourorganization.com/webhook/dentalcore"
